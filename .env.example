WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
DATABASE_URL=postgresql://kb:kb@localhost:5432/kb?schema=public
ADMIN_EMAILS=you@example.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Production only: public HTTPS API callback, also registered in Google Console.
# e.g. https://kb-api.fly.dev/auth/google/callback
GOOGLE_CALLBACK_URL=
JWT_SECRET=change-me-to-a-long-random-string
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
# DeepSeek generation timeout in ms (1000–120000; invalid values use 120000).
DEEPSEEK_TIMEOUT_MS=120000
# Video-to-note: third-party transcript API (Supadata). Feature is disabled until set.
TRANSCRIPT_API_URL=https://api.supadata.ai/v1
TRANSCRIPT_API_KEY=
# Mock interview models (independent of other AI features).
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_TTS_MODEL=gpt-4o-mini-tts
INTERVIEW_DEEPSEEK_MODEL=deepseek-flash
GRAFANA_ADMIN_PASSWORD=admin

# Personal ChatGPT: local callback; hosted API requires forwarding during sign-in.
# WEB_ORIGIN can be a public HTTPS origin. Keep this callback on HTTP 127.0.0.1.
CHATGPT_REDIRECT_URI=http://127.0.0.1:4000/chatgpt/callback
# Optional dedicated encryption secret. Defaults to JWT_SECRET; changing it requires reconnecting.
CHATGPT_TOKEN_SECRET=
# Docker overrides this to a persistent private volume.
CHATGPT_CREDENTIALS_DIR=.chatgpt

# Docker Compose overrides this with the internal Redis service.
REDIS_URL=redis://localhost:6379

# Required only when migrating existing shared notes/topics to one account.
LEGACY_OWNER_EMAIL=
