WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
DATABASE_URL=postgresql://kb:kb@localhost:5432/kb?schema=public
ADMIN_EMAILS=you@example.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
JWT_SECRET=change-me-to-a-long-random-string
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
GRAFANA_ADMIN_PASSWORD=admin

# Sign in with ChatGPT: local personal use, no owner API key required.
CHATGPT_REDIRECT_URI=http://127.0.0.1:4000/chatgpt/callback
# Optional dedicated encryption secret. Defaults to JWT_SECRET; changing it requires reconnecting.
CHATGPT_TOKEN_SECRET=
# Docker overrides this to a persistent private volume.
CHATGPT_CREDENTIALS_DIR=.chatgpt

# Docker Compose overrides this with the internal Redis service.
REDIS_URL=redis://localhost:6379

# Required only when migrating existing shared notes/topics to one account.
LEGACY_OWNER_EMAIL=
